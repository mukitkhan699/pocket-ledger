<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/fab_bottom_offset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textAppearance="@style/TextAppearance.PocketLedger.Title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/profileAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_icon_circle_accent"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Section" />

                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />

                    <TextView
                        android:id="@+id/profileBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="@dimen/space_10"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/cloud_connected"
                        android:textColor="@color/accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/account"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/mealPricesRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/default_meal_prices"
                        android:src="@drawable/ic_restaurant_menu"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/default_meal_prices"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/content_description_more"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/categoriesRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/categories"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/manage_categories"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/content_description_more"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/loansRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/loans"
                        android:src="@drawable/ic_loan"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/manage_loans"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/content_description_more"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/preferences"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/theme"
                        android:src="@drawable/ic_theme"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/theme"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/themeValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/notifications"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notifications"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notifications_desc"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/notificationsSwitch"
                        style="@style/Widget.PocketLedger.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/automatic_sync"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/automatic_sync"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/automatic_sync_desc"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/autoSyncSwitch"
                        style="@style/Widget.PocketLedger.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/data_sync"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/syncNowRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/sync_now"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/sync_now"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/syncStatusValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="@string/cloud_connected"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/last_sync"
                        android:src="@drawable/ic_cloud"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/last_sync"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/lastSyncValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="@string/never"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/pending_changes"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/pending_changes"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/pendingValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/conflictsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/sync_conflicts"
                        android:src="@drawable/ic_info"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/sync_conflicts"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/conflictsValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/backupRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/backup_restore"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_restore"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:id="@+id/lastBackupValue"
                            style="@style/Widget.PocketLedger.AmountText"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:layout_height="wrap_content"
                            android:text="@string/never_backed_up"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/content_description_more"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/about"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/currency"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/currency_fixed"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/versionValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_height="wrap_content"
                        android:text="1.0.0"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.PocketLedger.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/logout"
            android:textColor="@color/expense"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/expense" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_24" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

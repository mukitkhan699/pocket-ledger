<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/fab_bottom_offset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textAppearance="@style/TextAppearance.PocketLedger.Title" />

        <!-- Appearance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/appearance"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/theme"
                        android:src="@drawable/ic_theme"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/theme"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/themeValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/theme_dark"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/notifications"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/notifications"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/notifications_desc"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/notificationsSwitch"
                        style="@style/Widget.PocketLedger.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Account -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/account"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/syncNowRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/sync_now"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/sync_now"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/syncStatusValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/cloud_connected"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/last_sync"
                        android:src="@drawable/ic_cloud"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/last_sync"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/lastSyncValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/never"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Data -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/data"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/exportJsonRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/export_json"
                        android:src="@drawable/ic_download"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/export_json"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/exportCsvRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/export_csv"
                        android:src="@drawable/ic_download"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/export_csv"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/backupRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/backup_restore"
                        android:src="@drawable/ic_upload"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/backup_restore"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/security"
            android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/privacyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/privacy"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/privacy"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />
</LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/autoSyncRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/auto_sync"
                        android:src="@drawable/ic_sync"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/auto_sync"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/auto_sync_desc"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/autoSyncSwitch"
                        style="@style/Widget.PocketLedger.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:id="@+id/appLockRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/app_lock"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/app_lock"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/app_lock_desc"
                            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/appLockSwitch"
                        style="@style/Widget.PocketLedger.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about"
                android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        android:id="@+id/versionValue"
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="1.0.0"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>

                <View style="@style/Widget.PocketLedger.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    style="@style/Widget.PocketLedger.SettingsRow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/developer"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                    <TextView
                        style="@style/Widget.PocketLedger.AmountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/developer_value"
                        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.PocketLedger.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/logout"
            android:textColor="@color/expense"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/expense" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_24" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

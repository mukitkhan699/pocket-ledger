<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sms_title"
            android:textAppearance="@style/TextAppearance.PocketLedger.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/sms_subtitle"
            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />

        <!-- Permission card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/permissionCard"
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/content_description_sms"
                    android:src="@drawable/ic_sms"
                    app:tint="@color/warning" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/sms_permission_title"
                    android:textAppearance="@style/TextAppearance.PocketLedger.Section" />

                <TextView
                    android:id="@+id/permissionHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/sms_permission_needed"
                    android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantSmsButton"
                    style="@style/Widget.PocketLedger.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/grant_permission" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions card (shown when permission granted) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/actionsCard"
            style="@style/Widget.PocketLedger.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detected_messages"
                    android:textAppearance="@style/TextAppearance.PocketLedger.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/smsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/smsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:gravity="center"
                    android:text="@string/no_sms_messages"
                    android:textAppearance="@style/TextAppearance.PocketLedger.Caption"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualAddButton"
                    style="@style/Widget.PocketLedger.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/manual_add_transaction" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_24" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

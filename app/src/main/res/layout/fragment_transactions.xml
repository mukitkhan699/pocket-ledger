<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_transactions"
            android:textAppearance="@style/TextAppearance.PocketLedger.Title" />

        <ImageButton
            android:id="@+id/filterButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_toolbar_icon"
            android:contentDescription="@string/filter"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_14"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/space_10"
        android:hint="@string/search_transactions"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_14"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/filterSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.PocketLedger.Caption"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_10"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_20" />

    <LinearLayout
        android:id="@+id/transactionsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/no_transactions"
            android:src="@drawable/ic_history"
            app:tint="@color/text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/no_transactions"
            android:textAppearance="@style/TextAppearance.PocketLedger.Section" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/no_transactions_hint"
            android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
    </LinearLayout>
</LinearLayout>

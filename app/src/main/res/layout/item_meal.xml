<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PocketLedger.Card.Inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12">

        <ImageView
            android:id="@+id/mealIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/meal_type"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_food"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mealLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PocketLedger.BodyMedium" />

            <TextView
                android:id="@+id/mealAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/mealState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_planned"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="@dimen/space_2"
            android:text="@string/meal_planned"
            android:textColor="@color/planned"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/mealConsume"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_6"
            android:background="@drawable/bg_toolbar_icon"
            android:contentDescription="@string/content_description_check"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_check"
            app:tint="@color/income" />

        <ImageButton
            android:id="@+id/mealSkip"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_4"
            android:background="@drawable/bg_toolbar_icon"
            android:contentDescription="@string/content_description_skip"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_skip"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/reportCategoryIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/content_description_category_icon"
            android:padding="@dimen/space_6"
            android:src="@drawable/ic_other"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/reportCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PocketLedger.Body" />

        <TextView
            android:id="@+id/reportCategoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PocketLedger.Amount" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/reportCategoryBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/space_6"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/surface_alt" />
</LinearLayout>

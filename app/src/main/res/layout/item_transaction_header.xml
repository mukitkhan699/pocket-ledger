<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_14"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:id="@+id/headerDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/headerTotal"
        style="@style/Widget.PocketLedger.AmountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:maxWidth="@dimen/list_amount_max_width"
        android:textAppearance="@style/TextAppearance.PocketLedger.CaptionBold" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/space_24">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@string/no_transactions"
        android:src="@drawable/ic_history"
        app:tint="@color/text_tertiary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/no_transactions"
        android:textAppearance="@style/TextAppearance.PocketLedger.Section" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/no_transactions_hint"
        android:textAppearance="@style/TextAppearance.PocketLedger.Caption" />
</LinearLayout>
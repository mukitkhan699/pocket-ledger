<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PocketLedger" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorSecondaryVariant">@color/primary_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/expense</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PocketLedger.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.PocketLedger.BottomSheet</item>
        <item name="snackbarStyle">@style/Widget.PocketLedger.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.PocketLedger.Snackbar.TextView</item>
    </style>

    <style name="Theme.PocketLedger.Splash" parent="Theme.PocketLedger">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="ThemeOverlay.PocketLedger.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary_green</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PocketLedger.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PocketLedger.DialogButton</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.PocketLedger.Dialog</item>
    </style>

    <style name="Widget.PocketLedger.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearanceOverlay.PocketLedger.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ThemeOverlay.PocketLedger.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PocketLedger.BottomSheet</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <style name="Widget.PocketLedger.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.PocketLedger.BottomSheet</item>
    </style>

    <style name="ShapeAppearanceOverlay.PocketLedger.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="Widget.PocketLedger.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.PocketLedger.Snackbar.TextView" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>